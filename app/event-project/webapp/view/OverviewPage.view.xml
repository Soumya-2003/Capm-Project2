<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:macros="sap.fe.macros"
    xmlns="sap.m">

    <macros:Page id="OverviewPage">

    <VBox class="sapUiSmallMargin">

        <Title text="Event Overview Dashboard" level="H2" />

        <!-- Table -->
        <macros:Table
            id="EventTable"
            metaPath="@com.sap.vocabularies.UI.v1.LineItem"
            contextPath="/Event" />

        <!-- Chart -->
        <macros:Chart
            id="EventChart"
            metaPath="@com.sap.vocabularies.UI.v1.Chart#EventChart"
            contextPath="/Event" />

    </VBox>
    </macros:Page>

</mvc:View>