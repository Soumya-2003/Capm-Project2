{
	"_version": "1.83.0",
	"sap.app": {
		"id": "eventproject",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			]
		},
		"applicationVersion": {
			"version": "0.0.1"
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"resources": "resources.json",
		"sourceTemplate": {
			"id": "@sap/generator-fiori:lrop",
			"version": "1.21.0",
			"toolsId": "fdb6b5a2-a4ea-4121-954b-5d15c73a7294"
		},
		"dataSources": {
			"mainService": {
				"uri": "/odata/v4/event/",
				"type": "OData",
				"settings": {
					"annotations": [],
					"odataVersion": "4.01"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "",
			"favIcon": "",
			"phone": "",
			"phone@2": "",
			"tablet": "",
			"tablet@2": ""
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"flexEnabled": false,
		"dependencies": {
			"minUI5Version": "1.146.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.fe.templates": {},
				"sap.f": {},
				"sap.fe.macros": {},
				"sap.fe.core": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "eventproject.i18n.i18n",
					"supportedLocales": [
						""
					]
				}
			},
			"": {
				"dataSource": "mainService",
				"preload": true,
				"settings": {
					"operationMode": "Server",
					"autoExpandSelect": true,
					"earlyRequests": true
				}
			},
			"@i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"uri": "i18n/i18n.properties",
				"settings": {
					"supportedLocales": [
						""
					]
				}
			}
		},
		"resources": {
			"css": []
		},
		"routing": {
			"config": {
				"flexibleColumnLayout": {
					"defaultTwoColumnLayoutType": "TwoColumnsMidExpanded",
					"defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
				},
				"routerClass": "sap.f.routing.Router"
			},
			"routes": [
				{
					"pattern": "overview",
					"name": "OverviewPage",
					"target": [
						"OverviewPage"
					]
				},
				{
					"pattern": ":?query:",
					"name": "EventList",
					"target": [
						"EventList"
					]
				},
				{
					"pattern": "Event({key}):?query:",
					"name": "EventObjectPage",
					"target": [
						"EventList",
						"EventObjectPage"
					]
				},
				{
					"pattern": "Event({key})/tags({key2}):?query:",
					"name": "EventTagsObjectPage",
					"target": [
						"EventList",
						"EventObjectPage",
						"EventTagsObjectPage"
					]
				}
			],
			"targets": {
				"OverviewPage": {
					"type": "Component",
					"id": "OverviewPage",
					"name": "sap.fe.core.fpm",
					"controlAggregation": "beginColumnPages",
					"viewLevel": 1,
					"options": {
						"settings": {
							"viewName": "eventproject.view.OverviewPage",
							"viewType": "XML",
							"contextPath": "/Event"
						}
					}
				},
				"EventList": {
					"type": "Component",
					"id": "EventList",
					"name": "sap.fe.templates.ListReport",
					"controlAggregation": "beginColumnPages",
					"options": {
						"settings": {
							"contextPath": "/Event",
							"variantManagement": "Page",
							"navigation": {
								"Event": {
									"detail": {
										"route": "EventObjectPage"
									}
								}
							},
							"controlConfiguration": {
								"@com.sap.vocabularies.UI.v1.LineItem": {
									"tableSettings": {
										"type": "ResponsiveTable",
										"multiSelect": true,
										"enableMassEdit": true
									}
								}
							}
						}
					},
					"contextPattern": ""
				},
				"EventObjectPage": {
					"type": "Component",
					"id": "EventObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"controlAggregation": "midColumnPages",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/Event",
							"navigation": {
								"tags": {
									"detail": {
										"route": "EventTagsObjectPage"
									}
								}
							}
						}
					},
					"contextPattern": "/Event({key})"
				},
				"EventTagsObjectPage": {
					"type": "Component",
					"id": "EventTagsObjectPage",
					"name": "sap.fe.templates.ObjectPage",
					"options": {
						"settings": {
							"editableHeaderContent": false,
							"contextPath": "/Event/tags"
						}
					},
					"controlAggregation": "endColumnPages",
					"contextPattern": "/Event({key})/tags({key2})"
				}
			}
		},
		"rootView": {
			"viewName": "sap.fe.templates.RootContainer.view.Fcl",
			"type": "XML",
			"async": true,
			"id": "appRootView"
		},
		"flexBundle": false
	},
	"sap.fiori": {
		"registrationIds": [],
		"archeType": "transactional"
	},
	"sap.fe": {
		"app": {
			"enableLazyLoading": true
		}
	}
}